{
  "name": "altaha-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Altaha Screener for Android and iOS: the web frontend in a Capacitor shell.",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "icons": "capacitor-assets generate --iconBackgroundColor '#FBFAF7' --iconBackgroundColorDark '#FBFAF7' --splashBackgroundColor '#FBFAF7' --splashBackgroundColorDark '#0C0B08' --android --ios",
    "set-version": "node scripts/set-version.mjs",
    "test": "npm run build && node tests/bundle.test.mjs && node tests/app-browser.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "lightweight-charts": "^4.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "esbuild": "^0.28.2"
  }
}
