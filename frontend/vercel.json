{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/share", "destination": "https://taha-project.onrender.com/share/record" },
    { "source": "/share/:path*", "destination": "https://taha-project.onrender.com/share/:path*" },
    { "source": "/og/:path*", "destination": "https://taha-project.onrender.com/og/:path*" },
    { "source": "/stock-:symbol", "destination": "https://taha-project.onrender.com/pages/company/:symbol" },
    { "source": "/sector-:slug", "destination": "https://taha-project.onrender.com/pages/sector/:slug" },
    { "source": "/stocks", "destination": "https://taha-project.onrender.com/pages/stocks" },
    { "source": "/sitemap.xml", "destination": "https://taha-project.onrender.com/sitemap.xml" },
    { "source": "/stock", "destination": "/stock.html" },
    { "source": "/signin", "destination": "/signin.html" },
    { "source": "/wealth", "destination": "/wealth.html" },
    { "source": "/advisors", "destination": "/advisors.html" },
    { "source": "/brief", "destination": "/brief.html" },
    { "source": "/pro", "destination": "/pro.html" },
    { "source": "/pricing", "destination": "/pro.html" },
    { "source": "/forum", "destination": "/forum.html" },
    { "source": "/weekly", "destination": "/weekly.html" },
    { "source": "/glossary", "destination": "/glossary.html" },
    { "source": "/methodology", "destination": "/methodology.html" },
    { "source": "/planner", "destination": "/planner.html" },
    { "source": "/ownership-share", "destination": "/ownership-share.html" }
  ],
  "headers": [
    {
      "source": "/og/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    { "source": "/stock-:symbol", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }] },
    { "source": "/sector-:slug", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }] },
    { "source": "/stocks", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }] },
    { "source": "/sitemap.xml", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "1" }] }
  ]
}
