__pycache__/
*.pyc
.pytest_cache/

# Local development environment: the Python virtualenv and the local data
# directory (the mounted disk's stand-in), both created by .cursor/install.sh
# and .cursor/start.sh. Data, never source.
.venv/
.data/

# The point-in-time store. Data, never source — it lives on the mounted
# disk in production and is recreated locally by any test run.
altaha_pit.db
altaha_pit.db-*
research/.cache/

# XBRL documents fetched at runtime. Cache, never source.
xbrl-cache/

# Parsed shareholding filings. Cache, never source — a filed document
# never changes, so this is rebuilt on demand and never checked in.
shp-cache/

# Text extracted from filed PDFs, and the order / concall ledgers. Data and
# cache, never source: they live on the mounted disk in production and are
# rebuilt on demand anywhere else.
filing-text/
wow_orders.db
wow_orders.db-*
concalls.db
concalls.db-*
# One plain-English score explanation per stock per day. A cache: rebuilt by
# the next reader who asks.
explanations.db
explanations.db-*

# Browser-test screenshots and traces. Output, never source.
test-results/

# The holdings ledger: who holds what, from the shareholding filings and the
# fund houses' monthly disclosures. Data, never source — it lives on the
# mounted disk in production and is rebuilt by the crawlers anywhere else.
altaha_holdings.db
altaha_holdings.db-*

# NSE's ISIN -> symbol map, refreshed fortnightly. Cache, never source.
nse-isin-map.json

# Playwright, for the browser tests. CI installs it to /tmp and points
# NODE_PATH at it (see .github/workflows/portfolio-ui.yml); anyone running
# those tests on their own machine ends up with this here instead.
node_modules

# Every company's quarterly P&L. Data, never source — it lives on the mounted
# disk in production and is rebuilt by the fundamentals crawl anywhere else.
altaha_fundamentals.db
altaha_fundamentals.db-*

# The Lenses inputs and nightly results. Data and cache, never source — it
# lives on the mounted disk in production and is rebuilt by the lens jobs.
altaha_lenses.db
altaha_lenses.db-*

# The backup's scratch copies, deleted as soon as each file is uploaded.
.backup-tmp/
